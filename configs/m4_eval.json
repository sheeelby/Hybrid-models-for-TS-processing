{
  "categories": ["yearly", "quarterly", "daily", "hourly", "monthly", "weekly"],
  "n_per_cat": 10,
  "pick": "random",
  "seed": 42,
  "epochs": 20,
  "base_models": [
    "raw_timesnet",
    "raw_nbeats",
    "vw_timesnet_ets",
    "vw_timesnet_arima_auto",
    "vw_nbeats_ets",
    "vw_nbeats_arima_auto"
  ],
  "wavelet": "db4",
  "level": 3,
  "boundary": "wrap",
  "plot_test_only": true,
  "use_full_modwt_components": true,
  "simulate_full_series": true,
  "simulation_mode": "fitted",
  "simulation_train_only_plot": true,
  "force_rebuild_csv": false,
  "force_rebuild_global_components": false,
  "visualize": true
}