{
  "categories": ["quarterly"],
  "n_per_cat": 20,
  "pick": "random",
  "seed": 42,
  "epochs": 24,
  "base_models": [
    "vw_timesnet_ets",
    "vw_timesnet_arima_auto",
    "vw_nbeats_ets",
    "vw_nbeats_arima_auto",
    "stl_timesnet_ets",
    "stl_timesnet_arima_auto",
    "stl_nbeats_ets",
    "stl_nbeats_arima_auto"
  ],
  "wavelet": "db4",
  "level": 3,
  "boundary": "reflect",
  "stl_kwargs": {
    "robust": true
  },
  "plot_test_only": true,
  "simulate_full_series": false,
  "simulation_mode": "rollout",
  "simulation_train_only_plot": true,
  "force_rebuild_csv": false,
  "force_rebuild_global_components": false,
  "visualize": true,
  "out_prefix": "src/outputs/m4_eval_modwt_vs_stl_fair",
  "vw_kwargs": {
    "enable_output_blend": true,
    "detail_dampen": true,
    "detail_anchor": true,
    "residual_anchor": true
  },
  "model_params": {
    "timesnet": {
      "d_model": 160,
      "layers": 6,
      "topk": 6,
      "dropout": 0.1,
      "use_anchor": true
    },
    "nbeats": {
      "width": 896,
      "depth": 8,
      "nblocks": 12,
      "dropout": 0.1,
      "use_anchor": true,
      "share_weights": true,
      "use_trend": true,
      "use_seasonality": true,
      "use_generic": true,
      "diff_loss_weight": 0.06
    }
  }
}
