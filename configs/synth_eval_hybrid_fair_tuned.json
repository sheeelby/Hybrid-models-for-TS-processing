{
  "profiles": [
    "complex_seasonality_examples"
  ],
  "n_per_profile": 1,
  "length": 840,
  "horizon": 24,
  "epochs": 24,
  "base_models": [
    "timesnet",
    "nbeats",
    "vw_timesnet_arima_auto",
    "vw_nbeats_arima_auto",
    "vw_timesnet_ets",
    "vw_nbeats_ets",
    "stl_timesnet_arima_auto",
    "stl_nbeats_arima_auto",
    "stl_timesnet_ets",
    "stl_nbeats_ets"
  ],
  "seed": 42,
  "wavelet": "db4",
  "level": 3,
  "boundary": "wrap",
  "plot": true,
  "visualize": true,
  "use_full_modwt_components": false,
  "simulate_full_series": true,
  "simulation_mode": "rollout",
  "simulation_train_only_plot": true,
  "out_prefix": "src/outputs/synth_eval_hybrid_fair_tuned",
  "vw_kwargs": {
    "enable_output_blend": true,
    "detail_dampen": true,
    "detail_anchor": true,
    "residual_anchor": true
  },
  "model_params": {
    "timesnet": {
      "d_model": 160,
      "layers": 6,
      "topk": 6,
      "dropout": 0.1,
      "use_anchor": true
    },
    "nbeats": {
      "width": 896,
      "depth": 8,
      "nblocks": 12,
      "dropout": 0.1,
      "use_anchor": true,
      "share_weights": true,
      "use_trend": true,
      "use_seasonality": true,
      "use_generic": true,
      "diff_loss_weight": 0.06
    }
  }
}
