{
  "categories": ["quarterly"],
  "series_override": {
    "quarterly": ["Q2141", "Q2142", "Q2143", "Q2144", "Q2145", "Q2146", "Q2147", "Q2148", "Q2149"]
  },
  "n_per_cat": 9,
  "pick": "first",
  "seed": 42,
  "epochs": 5,
  "base_models": [
    "raw_timesnet",
    "raw_nbeats",
    "vw_timesnet_ets",
    "vw_timesnet_arima_auto",
    "vw_nbeats_ets",
    "vw_nbeats_arima_auto"
  ],
  "wavelet": "db4",
  "level": 3,
  "boundary": "reflect",
  "plot_test_only": true,
  "simulate_full_series": true,
  "simulation_mode": "rollot",
  "simulation_train_only_plot": true,
  "force_rebuild_csv": false,
  "force_rebuild_global_components": false,
  "visualize": true,
  "out_prefix": "src/outputs/m4_eval_q214x_best",
  "train_kwargs": {
    "batch_size": 16,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "clip": 1.0,
    "device": "cuda"
  },
  "vw_kwargs": {
    "enable_output_blend": true,
    "detail_dampen": true,
    "residual_anchor": true
  },
  "model_params": {
    "nbeats": {
      "width": 1024,
      "depth": 10,
      "nblocks": 8,
      "dropout": 0.0,
      "use_anchor": true,
      "share_weights": false,
      "use_trend": true,
      "use_seasonality": true,
      "use_generic": true,
      "diff_loss_weight": 0.06
    }
  }
}
